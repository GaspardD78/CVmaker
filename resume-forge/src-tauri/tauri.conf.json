{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResumeForge",
  "version": "1.1.0",
  "identifier": "com.jules.resume-forge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ResumeForge",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Créez et personnalisez vos CV professionnels",
    "longDescription": "ResumeForge est une application de bureau pour créer, personnaliser et exporter des CV professionnels. Gérez vos expériences, formations et compétences avec une interface intuitive et moderne.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["com.jules.resume-forge"]
      },
      "mobile": {
        "schemes": ["com.jules.resume-forge"]
      }
    }
  }
}
