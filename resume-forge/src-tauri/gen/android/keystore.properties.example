# Copy this file to keystore.properties and fill in your values.
# NEVER commit keystore.properties to git (it's in .gitignore).
#
# To generate a keystore (run once):
#   keytool -genkey -v -keystore resumeforge.keystore -alias resumeforge -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=../../../resumeforge.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=resumeforge
keyPassword=YOUR_KEY_PASSWORD
