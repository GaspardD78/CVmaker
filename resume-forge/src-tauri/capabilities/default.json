{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (desktop only)",
  "platforms": ["linux", "windows", "macOS"],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "sql:default",
    "fs:default",
    "dialog:default",
    "shell:default",
    "opener:default",
    "deep-link:default",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-select",
    "fs:allow-write-file",
    "fs:write-all",
    "fs:allow-read-file",
    "fs:read-all",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }]
    }
  ]
}