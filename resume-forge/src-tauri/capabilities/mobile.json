{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capabilities for Android and iOS",
  "platforms": ["android", "iOS"],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "sql:default",
    "fs:default",
    "dialog:default",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-select",
    "fs:allow-write-file",
    "fs:write-all",
    "fs:allow-read-file",
    "fs:read-all",
    "fs:scope-appcache-recursive",
    "fs:scope-appdata-recursive",
    "fs:scope-download-recursive",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }]
    }
  ]
}
